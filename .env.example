# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Tracing (optional locally; required for the deployed agent) ---
# Self-hosted (infra/deploy_langfuse_stack.sh) or LangFuse Cloud free tier.
# If unset, tracing is disabled entirely (see agent/tracing.py) -- the agent
# still runs, it just produces no spans.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Retrieval backend ---
# If unset, agent/rag.py's local FAISS+BM25 index is used (fine for local
# dev/demo.py). Set this to point retrieval at RDS PostgreSQL + pgvector
# instead -- the required backend for the deployed agent (see
# agent/rag_pgvector.py and scripts/seed_pgvector.py).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Deliberate regression flag, for the CI gate demo only ---
# When true, agent/harness.py's retrieve_node stops returning any policy
# grounding, simulating the same kind of "quietly broken" defect
# agent-cicd-demo ships with. Never set this in a real deploy.
AGENT_REGRESSED=false
